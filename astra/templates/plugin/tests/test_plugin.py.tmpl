"""Acceptance test generated with {{PLUGIN_NAME}}; no Telegram session is needed."""
from __future__ import annotations

import asyncio
import shutil
from pathlib import Path

from astra.testing import PluginHarness
from core.plugins.manager import PluginState
from core.registry import COMMANDS, list_registrations


def test_generated_plugin_loads_dispatches_and_unloads(tmp_path: Path) -> None:
    async def run() -> None:
        project_root = tmp_path / "project"
        plugin_root = project_root / "plugins"
        generated_source = Path(__file__).resolve().parents[1]
        generated_target = plugin_root / "{{PLUGIN_NAME}}"
        generated_target.parent.mkdir(parents=True)
        shutil.copytree(
            generated_source,
            generated_target,
            ignore=shutil.ignore_patterns("__pycache__", ".pytest_cache"),
        )

        module_name = "plugins.{{PLUGIN_NAME}}.plugin"
        command_pattern = r"^\.{{COMMAND_NAME}}-info$"
        before_ids = {item.registration_id for item in list_registrations()}

        async with PluginHarness(
            plugin_root=plugin_root,
            project_root=project_root,
        ) as harness:
            assert harness.manager is not None
            discovered = [record.name for record in harness.manager.records.values()]
            assert discovered == [module_name]

            record = harness.manager.records[module_name]
            assert record.state is PluginState.RUNNING
            assert record.version == "1.0.0"
            assert record.api_version == 1
            assert record.description == "Generated plugin scaffold for {{PLUGIN_NAME}}."
            assert record.dependencies == ()
            assert record.optional_dependencies == ()
            assert record.capabilities == ("telegram.read",)
            assert record.critical is False
            assert len(record.registrations) == 1

            registrations = [
                item for item in list_registrations()
                if item.pattern == command_pattern
            ]
            assert len(registrations) == 1
            assert registrations[0].registration_id in record.registrations
            assert len(harness.telegram.handlers) == 1

            dispatch = await harness.emit_command(".{{COMMAND_NAME}}-info")
            assert dispatch.matched is True
            assert len(dispatch.effects) == 1
            effect = dispatch.effects[0]
            assert effect.operation == "event.respond"
            assert "{{PLUGIN_NAME}} is a generated plugin scaffold." in effect.args[0]
            assert len(harness.effects) == 1

            await harness.manager.unload(module_name)
            assert record.state is PluginState.UNLOADED
            assert not record.registrations
            assert not harness.telegram.handlers
            assert command_pattern not in COMMANDS

        assert {item.registration_id for item in list_registrations()} == before_ids

    asyncio.run(run())
