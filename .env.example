# Telegram
API_ID=
API_HASH=
SESSION_STRING=

# Optional bot/API credentials
BOT_TOKEN=
BOT_API_KEY=

# Database
DATABASE_URL=

# Encrypted AstraUserbot vault master key
# Keep this outside the repository. Losing it makes encrypted vault entries unrecoverable.
ASTRA_VAULT_KEY=

# Archive retention controls
ASTRA_ARCHIVE_RETENTION_DAYS=30
ASTRA_ARCHIVE_MAX_MESSAGES=100000

# AI Gateway
# Provider: groq, gemini, or ollama
ASTRA_AI_PROVIDER=groq
# Automatic fallback order when the selected provider fails. Explicit provider= calls never fall back.
ASTRA_AI_FALLBACKS=gemini,ollama
# Remote providers are allowed only through this explicit switch and the bounded request budget below.
ASTRA_AI_REMOTE_ENABLED=true
ASTRA_AI_MAX_REMOTE_REQUESTS=100
ASTRA_AI_REMOTE_WINDOW_SECONDS=86400
# Model settings
ASTRA_AI_GROQ_MODEL=openai/gpt-oss-20b
ASTRA_AI_GEMINI_MODEL=gemini-2.5-flash
ASTRA_AI_OLLAMA_MODEL=qwen2.5:7b
ASTRA_AI_OLLAMA_URL=http://127.0.0.1:11434/api
ASTRA_AI_TRANSCRIBE_MODEL=whisper-large-v3
ASTRA_AI_MAX_AUDIO_BYTES=104857600

# Optional external services
GITHUB_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
