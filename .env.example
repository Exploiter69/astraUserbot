# Generated by tools/gen_env_example.py; do not hand-edit.
# Telethon uses a file session at data/<ASTRA_SESSION_NAME>.session.
# SESSION_STRING is not supported; authenticate using the file-session flow.

# Runtime configuration and compatibility aliases
# Required Telegram API ID; preferred config.py name.
ASTRA_API_ID=
# Legacy alias for ASTRA_API_ID.
API_ID=
# Required Telegram API hash; preferred config.py name.
ASTRA_API_HASH=
# Legacy alias for ASTRA_API_HASH.
API_HASH=

# Required numeric owner ID; preferred config.py name.
ASTRA_OWNER_ID=
# Legacy alias for ASTRA_OWNER_ID.
OWNER_ID=

# Telethon file-session basename under data/.
ASTRA_SESSION_NAME=astra_session
# Legacy alias for ASTRA_SESSION_NAME.
SESSION_NAME=astra_session

# Command prefix; preferred config.py name.
ASTRA_PREFIX=.
# Legacy alias for ASTRA_PREFIX.
PREFIX=.

# Python logging level.
ASTRA_LOG_LEVEL=INFO
# Set to 1 to skip plugin initialization.
ASTRA_SAFE_MODE=0
# Optional Groq API credential.
GROQ_API_KEY=
# Optional Gemini API credential.
GEMINI_API_KEY=
# Configured rclone remote for cloud backup.
RCLONE_REMOTE=teldrive-crypt:
# Master key for the encrypted local vault; keep private.
ASTRA_VAULT_KEY=
# Account-archive retention window in days.
ASTRA_ARCHIVE_RETENTION_DAYS=30
# Maximum retained account-archive messages.
ASTRA_ARCHIVE_MAX_MESSAGES=100000
# AI provider: groq, gemini, or ollama.
ASTRA_AI_PROVIDER=groq
# Explicit opt-in switch for remote AI providers.
ASTRA_AI_REMOTE_ENABLED=true
# Fallback provider order.
ASTRA_AI_FALLBACKS=gemini,ollama
# Remote AI request budget per window.
ASTRA_AI_MAX_REMOTE_REQUESTS=100
# Remote AI budget window in seconds.
ASTRA_AI_REMOTE_WINDOW_SECONDS=86400
# Groq model identifier.
ASTRA_AI_GROQ_MODEL=openai/gpt-oss-20b
# Gemini model identifier.
ASTRA_AI_GEMINI_MODEL=gemini-2.5-flash
# Local Ollama model identifier.
ASTRA_AI_OLLAMA_MODEL=qwen2.5:7b
# Loopback Ollama API base URL.
ASTRA_AI_OLLAMA_URL=http://127.0.0.1:11434/api
# Audio transcription model identifier.
ASTRA_AI_TRANSCRIBE_MODEL=whisper-large-v3
# Maximum audio input size in bytes.
ASTRA_AI_MAX_AUDIO_BYTES=104857600

# Optional local vault, archive, and AI settings are listed above.
# Keep credential values private; never commit a populated .env file.
