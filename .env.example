# Telegram
API_ID=
API_HASH=
SESSION_STRING=

# Optional bot/API credentials
BOT_TOKEN=
BOT_API_KEY=

# Database
DATABASE_URL=

# Encrypted AstraUserbot vault master key
# Keep this outside the repository. Losing it makes encrypted vault entries unrecoverable.
ASTRA_VAULT_KEY=

# Archive retention controls
ASTRA_ARCHIVE_RETENTION_DAYS=30
ASTRA_ARCHIVE_MAX_MESSAGES=100000

# AI Gateway
# Provider: groq or gemini
ASTRA_AI_PROVIDER=groq
# Current Groq free-plan compatible model; override if your account exposes another model.
ASTRA_AI_GROQ_MODEL=openai/gpt-oss-20b
ASTRA_AI_GEMINI_MODEL=gemini-2.5-flash
ASTRA_AI_TRANSCRIBE_MODEL=whisper-large-v3
ASTRA_AI_MAX_AUDIO_BYTES=104857600

# Optional external services
GITHUB_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
